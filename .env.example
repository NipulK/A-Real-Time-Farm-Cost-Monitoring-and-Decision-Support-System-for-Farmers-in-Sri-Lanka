# Local SQLite and private receipts (default ./storage). Never commit storage.
FARMWISE_STORAGE=./storage
# Supabase integration is NOT enabled. Do not place credentials until adapter is implemented.
# Only for a separately configured HTTPS endpoint; leave unset for loopback use.
# FARMWISE_ORIGIN=https://your-approved-host.example
# FARMWISE_HTTPS=true

# Temporary local-viva mode only. Unset/false keeps the 12-character minimum.
# FARMWISE_DEMO_PASSWORDS=false
